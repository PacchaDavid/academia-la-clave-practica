---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatearFecha, getEvento } from '../../lib/eventos';

const { slug } = Astro.params;
const evento = slug ? await getEvento(slug) : undefined;

if (!evento) {
  return Astro.rewrite('/404');
}

const { data, bodyHtml } = evento;
const {
  titulo,
  fecha,
  hora,
  lugar,
  categoria,
  resumen,
  imagen,
  imagen_alt,
  precio,
} = data;

const fechaISO = fecha.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: titulo,
  description: resumen,
  startDate: `${fechaISO}T${hora}:00`,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: lugar,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Calle del Compás, 14',
      postalCode: '46001',
      addressLocality: 'Valencia',
      addressCountry: 'ES',
    },
  },
  image: [imagen],
  organizer: {
    '@type': 'Organization',
    name: 'Academia La Clave',
    url: Astro.site?.href,
  },
};
---

<BaseLayout
  titulo={titulo}
  descripcion={resumen}
  imagen={imagen}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="evento">
    <div class="wrap evento-hero">
      <nav class="migas" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/eventos/">Eventos</a>
        <span aria-hidden="true">/</span>
        <span>{categoria}</span>
      </nav>

      <div class="evento-hero__grid">
        <div class="evento-hero__media">
          <img
            src={imagen}
            alt={imagen_alt}
            width="1200"
            height="800"
            fetchpriority="high"
          />
        </div>

        <div>
          <p class="antetitulo">{categoria}</p>
          <h1 class="display" style="font-size: clamp(2.2rem, 4.8vw, 3.8rem);">
            {titulo}
          </h1>
          <p class="entradilla" style="margin-top: 1.25rem;">{resumen}</p>

          <div class="evento-meta">
            <div class="evento-meta__fila">
              <span class="evento-meta__clave">Fecha</span>
              <span class="evento-meta__valor">
                <time datetime={fechaISO}>{formatearFecha(fecha)}</time>
              </span>
            </div>
            <div class="evento-meta__fila">
              <span class="evento-meta__clave">Hora</span>
              <span class="evento-meta__valor">{hora} h</span>
            </div>
            <div class="evento-meta__fila">
              <span class="evento-meta__clave">Lugar</span>
              <span class="evento-meta__valor">{lugar}</span>
            </div>
            <div class="evento-meta__fila">
              <span class="evento-meta__clave">Entrada</span>
              <span class="evento-meta__valor">{precio}</span>
            </div>
          </div>

          <a class="btn btn--terracota" href="/contacto/">
            Reserva tu plaza
            <span class="btn__flecha" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="wrap seccion seccion--ajustada">
      <div class="evento-cuerpo" set:html={bodyHtml} />

      <div class="evento-pie">
        <a class="enlace-flecha" href="/eventos/">
          <span aria-hidden="true">←</span> Volver a la agenda
        </a>
        <a class="btn btn--fantasma" href="/contacto/">
          Tengo una pregunta
          <span class="btn__flecha" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
