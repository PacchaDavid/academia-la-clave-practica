# Sanity: ID del proyecto y dataset. No son secretos; el dataset es público.
# En Netlify, defínelas en Site configuration → Environment variables.
SANITY_PROJECT_ID=th9dmvr0
SANITY_DATASET=production

# Solo para la migración inicial de los .md (rol Editor). No lo necesitas
# para que el sitio funcione, así que puedes borrarlo después.
# SANITY_WRITE_TOKEN=
